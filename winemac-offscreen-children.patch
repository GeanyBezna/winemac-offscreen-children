+static BOOL window_has_visible_children(HWND hwnd)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    HWND child;
+
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        RECT rect;
+
+        if (!NtUserIsWindowVisible(child)) continue;
+        if (!NtUserGetClientRect(child, &rect, dpi)) continue;
+        if (rect.right > rect.left && rect.bottom > rect.top) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL get_window_pixel_size(HWND hwnd, int *width, int *height)
+{
+    RECT rect;
+
+    if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return FALSE;
+    *width = rect.right - rect.left;
+    *height = rect.bottom - rect.top;
+    return *width > 0 && *height > 0;
 }
 
+static void blit_frame_to_window(struct gl_drawable *gl, int width, int height)
+{
+    BITMAPINFO info;
+    UINT dpi = NtUserGetWinMonitorDpi(gl->hwnd, MDT_RAW_DPI);
+    HDC hdc;
+    HWND child;
+
+    if (!gl->bits || !(hdc = NtUserGetDCEx(gl->hwnd, 0, DCX_CACHE | DCX_USESTYLE))) return;
+
+    for (child = NtUserGetWindowRelative(gl->hwnd, GW_CHILD); child;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        RECT rect;
+
+        if (!NtUserIsWindowVisible(child)) continue;
+        if (!NtUserGetWindowRect(child, &rect, dpi)) continue;
+        NtUserMapWindowPoints(0, gl->hwnd, (POINT *)&rect, 2, dpi);
+        NtGdiExcludeClipRect(hdc, rect.left, rect.top, rect.right, rect.bottom);
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = height;  /* bottom-up: same row order as glReadPixels */
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    NtGdiSetDIBitsToDeviceInternal(hdc, 0, 0, width, height, 0, 0, 0, height, gl->bits, &info,
+                                   DIB_RGB_COLORS, width * height * 4, sizeof(BITMAPINFO), FALSE, 0);
+    NtUserReleaseDC(gl->hwnd, hdc);
+}
