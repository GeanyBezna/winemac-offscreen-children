+/* The GL view is composited above the window surface, which also holds the pixels of the
+   child windows; while visible child windows cover part of the client area, the frame is
+   presented through the window surface instead, below the children. */
+static BOOL needs_offscreen_rendering(HWND hwnd)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    RECT client, rect;
+    HWND child;
+
+    if (!(child = NtUserGetWindowRelative(hwnd, GW_CHILD))) return FALSE;
+    if (!NtUserGetClientRect(hwnd, &client, dpi)) return FALSE;
+
+    for (; child; child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        if (!NtUserIsWindowVisible(child) || !NtUserGetWindowRect(child, &rect, dpi)) continue;
+        NtUserMapWindowPoints(0, hwnd, (POINT *)&rect, 2, dpi);
+        if (rect.left < client.right && rect.right > client.left &&
+            rect.top < client.bottom && rect.bottom > client.top)
+            return TRUE;
     }
+
+    return FALSE;
 }
 
+static void present_offscreen_frame(struct macdrv_client_surface *surface, HDC hdc)
+{
+    HWND hwnd = surface->client.hwnd, child;
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    BITMAPINFO info;
+    RECT rect;
+
+    NtGdiSaveDC(hdc);
+
+    /* the window may not have WS_CLIPCHILDREN, keep the children's pixels anyway */
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child; child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        if (!NtUserIsWindowVisible(child) || !NtUserGetWindowRect(child, &rect, dpi)) continue;
+        NtUserMapWindowPoints(0, hwnd, (POINT *)&rect, 2, dpi);
+        NtGdiExcludeClipRect(hdc, rect.left, rect.top, rect.right, rect.bottom);
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = surface->offscreen_width;
+    info.bmiHeader.biHeight = surface->offscreen_height; /* bottom-up, like glReadPixels */
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    NtGdiSetDIBitsToDeviceInternal(hdc, 0, 0, surface->offscreen_width, surface->offscreen_height, 0, 0, 0,
+                                   surface->offscreen_height, surface->offscreen_bits, &info, DIB_RGB_COLORS,
+                                   (size_t)surface->offscreen_width * surface->offscreen_height * 4,
+                                   sizeof(info), FALSE, NULL);
+
+    NtGdiRestoreDC(hdc, -1);
+}
