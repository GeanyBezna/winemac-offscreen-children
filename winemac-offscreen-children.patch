 static BOOL macdrv_surface_swap(struct opengl_drawable *base)
 {
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
     struct macdrv_context *context = NtCurrentTeb()->glReserved2;
+    int width, height;
 
     TRACE("%s context %p/%p/%p\n", debugstr_opengl_drawable(base), context, (context ? context->context : NULL),
           (context ? context->cglcontext : NULL));
 
+    if (!context) return FALSE;
+
+    if (gl->hwnd)
+    {
+        BOOL offscreen = window_has_visible_children(gl->hwnd);
+
+        if (offscreen != gl->offscreen)
+        {
+            struct macdrv_client_surface *client;
+
+            TRACE("hwnd %p: %s offscreen rendering\n", gl->hwnd, offscreen ? "enabling" : "disabling");
+            gl->offscreen = offscreen;
+            if (gl->base.client && (client = impl_from_client_surface(gl->base.client)))
+                macdrv_set_view_hidden(client->cocoa_view, offscreen);
+        }
+
+        if (offscreen && !get_window_pixel_size(gl->hwnd, &width, &height)) return FALSE;
+    }
+
+    if (gl->hwnd && gl->offscreen)
+    {
+        if (gl->bits_size < (size_t)width * height * 4)
+        {
+            free(gl->bits);
+            free(gl->row);
+            gl->bits = malloc((size_t)width * height * 4);
+            gl->bits_size = gl->bits ? (size_t)width * height * 4 : 0;
+            gl->row = malloc((size_t)width * 4);
+        }
+        if (!gl->bits || !gl->row) return FALSE;
+
+        pglReadBuffer(gl->base.doublebuffer ? GL_BACK : GL_FRONT);
+        pglReadPixels(0, 0, width, height, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, gl->bits);
+        /* glReadPixels returns bottom-up rows, GDI wants top-down here */
+        for (int y = 0; y < height / 2; y++)
+        {
+            unsigned char *top = (unsigned char *)gl->bits + (size_t)y * width * 4;
+            unsigned char *bottom = (unsigned char *)gl->bits + (size_t)(height - 1 - y) * width * 4;
+            memcpy(gl->row, top, (size_t)width * 4);
+            memcpy(top, bottom, (size_t)width * 4);
+            memcpy(bottom, gl->row, (size_t)width * 4);
+        }
+        blit_frame_to_window(gl, width, height);
+    }
+
     macdrv_flush_opengl_context(context->context);
     return TRUE;
 }
