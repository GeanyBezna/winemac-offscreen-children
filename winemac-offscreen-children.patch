+/* Read the finished frame from the drawable's own framebuffer, whatever the application
+   left bound, and restore its state afterwards. */
+static void read_offscreen_frame(struct macdrv_client_surface *client, BOOL doublebuffer)
+{
+    static const GLenum pack_names[] = {GL_PACK_ALIGNMENT, GL_PACK_ROW_LENGTH, GL_PACK_SKIP_ROWS,
+                                        GL_PACK_SKIP_PIXELS, GL_PACK_SWAP_BYTES};
+    static const GLint pack_values[] = {4, 0, 0, 0, GL_FALSE};
+    GLint read_fbo = 0, read_buffer = 0, pack_buffer = 0, pack[ARRAY_SIZE(pack_names)];
+    HWND hwnd = client->client.hwnd;
+    size_t size;
+    RECT rect;
+    UINT i;
+
+    if (!NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return;
+    if (rect.right <= rect.left || rect.bottom <= rect.top) return;
+
+    size = (size_t)(rect.right - rect.left) * (rect.bottom - rect.top) * 4;
+    if (size > client->offscreen_size)
+    {
+        free(client->offscreen_bits);
+        client->offscreen_size = 0;
+        if (!(client->offscreen_bits = malloc(size))) return;
+        client->offscreen_size = size;
+    }
+    client->offscreen_width = rect.right - rect.left;
+    client->offscreen_height = rect.bottom - rect.top;
+
+    pglGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    if (read_fbo) pglBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    pglGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    pglReadBuffer(doublebuffer ? GL_BACK : GL_FRONT);
+    pglGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    if (pack_buffer) pglBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    for (i = 0; i < ARRAY_SIZE(pack_names); i++)
+    {
+        pglGetIntegerv(pack_names[i], &pack[i]);
+        pglPixelStorei(pack_names[i], pack_values[i]);
+    }
+
+    pglReadPixels(0, 0, client->offscreen_width, client->offscreen_height, GL_BGRA,
+                  GL_UNSIGNED_INT_8_8_8_8_REV, client->offscreen_bits);
+    client->offscreen_valid = TRUE;
+
+    for (i = 0; i < ARRAY_SIZE(pack_names); i++) pglPixelStorei(pack_names[i], pack[i]);
+    if (pack_buffer) pglBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+    pglReadBuffer(read_buffer);
+    if (read_fbo) pglBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
 }
 
 static BOOL macdrv_surface_swap(struct opengl_drawable *base)
 {
+    struct macdrv_client_surface *client = impl_from_client_surface(base->client);
+    struct gl_drawable *gl = impl_from_opengl_drawable(base);
     struct macdrv_context *context = NtCurrentTeb()->glReserved2;
+    BOOL offscreen = InterlockedCompareExchange(&base->client->offscreen, 0, 0);
 
-    TRACE("%s context %p/%p/%p\n", debugstr_opengl_drawable(base), context, (context ? context->context : NULL),
-          (context ? context->cglcontext : NULL));
+    TRACE("%s context %p/%p/%p offscreen %u\n", debugstr_opengl_drawable(base), context,
+          (context ? context->context : NULL), (context ? context->cglcontext : NULL), offscreen);
 
+    if (offscreen) read_offscreen_frame(client, base->doublebuffer);
     macdrv_flush_opengl_context(context->context);
+    /* present the frame through the window surface, or give the view back once the children are gone */
+    if (offscreen || gl->offscreen) client_surface_present(base->client);
+    gl->offscreen = offscreen;
     return TRUE;
 }
 
